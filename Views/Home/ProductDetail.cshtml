@model ReaB_Bakery.Models.Product
@using ReaB_Bakery.Helpers
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
}

<div class="product-detail-wrapper">

    <!-- Back link -->
    <a href="@Url.Action("Menu", "Home")" class="product-detail-back">
        ← Back to Menu
    </a>

    <div class="product-detail-container">

        <!-- Left: Image -->
        <div class="product-detail-img-wrap">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="product-detail-img" />
            <div class="product-detail-badge">@Model.Category</div>
        </div>

        <!-- Right: Order Form -->
        <div class="product-detail-form-wrap">
            <h1 class="product-detail-name">@Model.Name</h1>
            <p class="product-detail-desc">@Model.Description</p>
            <p class="product-detail-price">From @CurrencyHelper.FormatAmount(Model.Price)</p>

            <form asp-controller="Home" asp-action="PlaceCustomOrder"
                  method="post" enctype="multipart/form-data" class="custom-order-form">

                <input type="hidden" name="ProductId" value="@Model.Id" />
                <input type="hidden" name="ProductName" value="@Model.Name" />
                <input type="hidden" name="ProductPrice" value="@Model.Price" />

                <!-- Customer Info -->
                <div class="order-section-title">Your Details</div>

                <div class="order-field">
                    <label>Full Name</label>
                    <input type="text" name="CustomerName" placeholder="e.g. Thabo Mokoena" required />
                </div>

                <div class="order-field">
                    <label>Email Address</label>
                    <input type="email" name="CustomerEmail" placeholder="e.g. you@email.com" required />
                </div>

                <div class="order-field">
                    <label>Phone Number</label>
                    <input type="tel" name="CustomerPhone" placeholder="e.g. 071 234 5678" required />
                </div>

                <!-- Cake Options -->
                <div class="order-section-title">Cake Options</div>

                <div class="order-field">
                    <label>Cake Flavour</label>
                    <select name="CakeFlavour" id="flavourSelect" required>
                        <option value="" disabled selected>Select a flavour...</option>
                        <option value="Chocolate">Chocolate</option>
                        <option value="Vanilla">Vanilla</option>
                        <option value="Red Velvet">Red Velvet</option>
                        <option value="Carrot">Carrot</option>
                        <option value="Lemon">Lemon</option>
                        <option value="Caramel">Caramel</option>
                        <option value="Black Forest">Black Forest</option>
                        <option value="Other">Other (specify)</option>
                    </select>
                </div>

                <!-- Other flavour text box -->
                <div class="order-field" id="otherFlavourField" style="display:none;">
                    <label>Specify Flavour</label>
                    <input type="text" name="OtherFlavour" placeholder="e.g. Peanut butter chocolate" />
                </div>

                <div class="order-field">
                    <label>Cake Colour</label>
                    <div class="colour-options">
                        <label class="colour-radio">
                            <input type="radio" name="CakeColour" value="As Shown" checked />
                            <span>As Shown</span>
                        </label>
                        <label class="colour-radio">
                            <input type="radio" name="CakeColour" value="Custom" />
                            <span>Custom Colour</span>
                        </label>
                    </div>
                </div>

                <!-- Custom colour field -->
                <div class="order-field" id="customColourField" style="display:none;">
                    <label>Describe Your Colour</label>
                    <input type="text" name="CustomColour"
                           placeholder="e.g. Sage green with gold accents" />
                </div>

                <div class="order-field">
                    <label>Delivery Date</label>
                    <input type="date" name="DeliveryDate" required
                           min="@DateTime.Now.AddDays(3).ToString("yyyy-MM-dd")" />
                    <small class="field-hint">Please order at least 3 days in advance</small>
                </div>

                <!-- Design -->
                <div class="order-section-title">Design Details</div>

                <div class="order-field">
                    <label>Design Notes <span class="optional">(optional)</span></label>
                    <textarea name="DesignNotes" rows="4"
                              placeholder="e.g. I'd like pink roses on top with 'Happy Birthday Sarah' written in gold..."></textarea>
                </div>

                <div class="order-field">
                    <label>Inspiration Photo <span class="optional">(optional)</span></label>
                    <input type="file" name="InspirationPhoto" accept="image/*" />
                    <small class="field-hint">Upload a photo of a cake you love for reference</small>
                </div>

                <!-- Submit -->
                <div class="order-submit-row">
                    <button type="submit" class="btn-place-order">
                        🎂 Place Order & Pay Deposit
                    </button>
                </div>

                <p class="deposit-note">
                    💳 After placing your order, you'll receive payment details for your deposit.
                    We'll confirm your order once the deposit is received.
                </p>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show/hide other flavour
        document.getElementById('flavourSelect').addEventListener('change', function () {
            document.getElementById('otherFlavourField').style.display =
                this.value === 'Other' ? 'block' : 'none';
        });

        // Show/hide custom colour
        document.querySelectorAll('input[name="CakeColour"]').forEach(radio => {
            radio.addEventListener('change', function () {
                document.getElementById('customColourField').style.display =
                    this.value === 'Custom' ? 'block' : 'none';
            });
        });

      
    </script>
}