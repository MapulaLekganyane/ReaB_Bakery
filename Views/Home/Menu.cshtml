@model IEnumerable<ReaB_Bakery.Models.Product>
@using ReaB_Bakery.Helpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Our Menu";
}

<div class="container mt-4">
    <h1 class="menu-page-title">Our Menu</h1>
    

    @if (TempData["CustomSuccess"] != null)
    {
        <div class="custom-success-banner">
            @TempData["CustomSuccess"]
        </div>
    }


    <!-- Category Filter Pills -->
    <div class="mb-4 text-center">
        <a href="@Url.Action("Menu", "Home")"
           class="btn @(ViewBag.Category == null ? "btn-pink" : "btn-outline-pink") me-2">
            All Items
        </a>
        @foreach (var category in ViewBag.Categories)
        {
            <a href="@Url.Action("Menu", "Home", new { category = category })"
               class="btn @(ViewBag.Category == category ? "btn-pink" : "btn-outline-pink") me-2">
                @category
            </a>
        }
    </div>

    <!-- Toast -->
    <div id="cartToast" class="cart-toast">✔ Added to cart!</div>

    <!-- Grouped by Category -->
    <!-- Products -->
    @if (ViewBag.Category == null)
    {
        <!-- All Items — flat continuous grid -->
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product-card-wrapper">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    }
    else
    {
        <!-- Filtered by category -->
        @foreach (var group in ViewBag.GroupedProducts as Dictionary<string, List<ReaB_Bakery.Models.Product>>)
        {
            if (ViewBag.Category != group.Key) continue;
            <div class="menu-category-section">
                <div class="product-grid">
                    @foreach (var product in group.Value)
                    {
                        <div class="product-card-wrapper">
                            @await Html.PartialAsync("_ProductCard", product)
                        </div>
                    }
                </div>
            </div>
        }
    }







</div>

@section Scripts {
    <script>
        function toggleCustomize(id) {
            const panel = document.getElementById('customize-' + id);
            const examples = document.getElementById('examples-' + id);
            examples.style.display = 'none';
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        function toggleExamples(id) {
            const panel = document.getElementById('examples-' + id);
            const customize = document.getElementById('customize-' + id);
            customize.style.display = 'none';
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

                // Auto-hide success banner
        const banner = document.querySelector('.custom-success-banner');
        if (banner) {
            setTimeout(() => {
                banner.style.transition = 'opacity 0.5s ease';
                banner.style.opacity = '0';
                setTimeout(() => banner.remove(), 500);
            }, 2000);
        }

        // Cart quantity buttons
        document.querySelectorAll('.add-cart-form').forEach(form => {
            form.querySelector('.minus').addEventListener('click', () => {
                const input = form.querySelector('.quantity-input');
                if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
            });
            form.querySelector('.plus').addEventListener('click', () => {
                const input = form.querySelector('.quantity-input');
                input.value = parseInt(input.value) + 1;
            });
        });
    </script>
}