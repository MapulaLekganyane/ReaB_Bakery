@{
    Layout = "_Layout";
    ViewData["Title"] = "About";
}
<!-- About Section -->
<section id="about">
    <div class="about container">
        <div class="col-left">
            <div class="about-img">
                    <img src="~/images/logo.jpeg" alt="img" />
            </div>
        </div>
        <div class="col-right">
            <h1 class="section-title">
                ABOUT <span>REAB BAKERY</span>
            </h1>
            <h2>Homemade with love, crafted for every celebration.</h2>
            <p>
                Welcome to ReaB Bakery, a home-based bakery founded by <b>Ephenia Malatsa</b> in 2023. What began as a passion for baking has grown into a business dedicated to creating beautiful, handcrafted cakes for life's most special moments.<br>

                At ReaB Bakery, we specialize in custom cakes, bento cakes, cupcakes, celebration cakes, and unique designs tailored to your vision. Every cake is carefully made using quality ingredients, creativity, and attention to detail, ensuring a perfect balance of taste and presentation.

                Whether you're celebrating a birthday, baby shower, graduation, anniversary, bridal shower, wedding, or any special occasion, we are committed to bringing your ideas to life. <br>
                From elegant designs to fun and trendy creations, every order is made with care and a personal touch.

                Thank you for choosing ReaB Bakery. We look forward to being part of your celebrations and creating sweet memories that last long after the last slice is enjoyed.
            </p>

                <a href="~/images/PriceList.jpeg" download class="cta">Browse our cakes</a>



        </div>
    </div>
</section>
<!-- End About Section -->
