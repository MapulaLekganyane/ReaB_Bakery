@model List<ReaB_Bakery.Models.CustomOrder>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int>;
    var selected = ViewBag.SelectedStatus as string;
}

<div class="admin-page-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Orders</h2>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-pink">Log Out</button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Completed Revenue (all time)</h6>
                    <h3 class="mb-0">R@(((decimal)ViewBag.CompletedRevenue).ToString("0.00"))</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Total for Current View (@selected)</h6>
                    <h3 class="mb-0">R@(((decimal)ViewBag.FilteredTotal).ToString("0.00"))</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        @foreach (var s in new[] { "All", "Pending", "In Progress", "Completed" })
        {
            var count = statusCounts != null && statusCounts.ContainsKey(s) ? statusCounts[s] : 0;
            <a href="@Url.Action("Dashboard", new { status = s })"
               class="btn @(selected == s ? "btn-pink" : "btn-outline-pink") me-2">
                @s (@count)
            </a>
        }
    </div>

    <br />
    <br />
    <br />
 


    @if (!Model.Any())
    {
        <p>No orders found.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Product</th>
                    <th>Delivery Date</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderReference</td>
                        <td>@order.CustomerName</td>
                        <td>@order.CustomerPhone</td>
                        <td>@order.ProductName</td>
                        <td>@order.DeliveryDate.ToString("dd MMM yyyy")</td>
                        <td>@order.ProductPrice.ToString("0.00")</td>

                        <td>
                            <form asp-controller="Admin" asp-action="UpdateStatus" method="post" class="d-flex">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="returnStatus" value="@selected" />
                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="Pending" selected="@(order.Status == "Pending" ? "selected" : null)">Pending</option>
                                    <option value="In Progress" selected="@(order.Status == "In Progress" ? "selected" : null)">In Progress</option>
                                    <option value="Completed" selected="@(order.Status == "Completed" ? "selected" : null)">Completed</option>
                                </select>
                            </form>
                        </td>
                        <td>
                            <a href="@Url.Action("OrderDetail", new { id = order.Id })" class="btn btn-sm btn-outline-pink">View / Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>