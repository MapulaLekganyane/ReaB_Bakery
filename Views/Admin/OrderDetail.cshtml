@model ReaB_Bakery.Models.CustomOrder
@{
    Layout = "_Layout";
    ViewData["Title"] = "Order " + Model.OrderReference;
}

<div class="admin-page-wrapper" style="max-width: 800px;">
    <a href="@Url.Action("Dashboard")" class="mb-3 d-inline-block">← Back to Dashboard</a>
    <h2>Order @Model.OrderReference</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Customer</h5>
            <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
            <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
            <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>
            <p class="mb-0"><strong>Ordered:</strong> @Model.OrderedAt.ToString("dd MMM yyyy, HH:mm")</p>
            <p class="mb-1"><strong>Delivery Date:</strong> @Model.DeliveryDate.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Cake Details</h5>
            <p class="mb-1"><strong>Product:</strong> @Model.ProductName</p>
            <p class="mb-1"><strong>Price:</strong> @Model.ProductPrice.ToString("0.00")</p>
            <p class="mb-1">
                <strong>Flavour:</strong>
                @(Model.CakeFlavour == "Other" && !string.IsNullOrEmpty(Model.OtherFlavour) ? Model.OtherFlavour : Model.CakeFlavour)
            </p>
            <p class="mb-0">
                <strong>Colour:</strong>
                @(Model.CakeColour == "Custom" && !string.IsNullOrEmpty(Model.CustomColour) ? Model.CustomColour : Model.CakeColour)
            </p>
            @if (!string.IsNullOrEmpty(Model.InspirationPhotoPath))
            {
                <div class="mt-3">
                    <strong>Inspiration Photo:</strong><br />
                    <img src="@Model.InspirationPhotoPath" alt="Inspiration photo" style="max-width: 300px; border-radius: 8px;" class="mt-2" />
                </div>
            }
        </div>
    </div>

    <form asp-controller="Admin" asp-action="OrderDetail" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">Pending</option>
                <option value="In Progress" selected="@(Model.Status == "In Progress" ? "selected" : null)">In Progress</option>
                <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Completed</option>
            </select>
        </div>

       

        <div class="mb-3">
            <label class="form-label">Design Notes</label>
            <textarea name="designNotes" rows="4" class="form-control">@Model.DesignNotes</textarea>
        </div>

        <button type="submit" class="btn btn-pink">Save Changes</button>
    </form>
</div>